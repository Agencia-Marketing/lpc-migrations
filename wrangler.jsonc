{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lpc-migrations",
  "pages_build_output_dir": "dist",
  "pages_build_command": "npm run build",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  // Required by @astrojs/cloudflare for SSR sessions. Namespace
  // "lpc-migrations-SESSION" lives in the "Programacion Agencia" account.
  // When the site moves to the client's own account in Fase 6, recreate the
  // namespace there and swap this id — a namespace id is account-scoped.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "82be22a8ef87452e90465e3df6c2f536"
    }
  ]
}
