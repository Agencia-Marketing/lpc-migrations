---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, CONTACT, SOCIAL } from '../config/site';

export interface Props {
  title: string;
  description?: string;
  lang?: 'es' | 'en';
  /** Extra JSON-LD objects for this page (FAQPage, BreadcrumbList, ...). The
   * ProfessionalService block is always included and does not need to be
   * passed in. */
  jsonLd?: object[];
  /** Absolute or root-relative URL for og:image / twitter:image. */
  ogImage?: string;
  /** Override the derived Spanish/English path pair. Required whenever the
   * two languages don't share the same slug (e.g. /aviso-legal vs
   * /en/legal-notice) — the default derivation below assumes they do. */
  esPath?: string;
  enPath?: string;
  /** Only the 4 pages with a contact form (both home pages, both /contacto
   * pages) need the Turnstile script — everyone else was loading it dead. */
  needsTurnstile?: boolean;
}

const {
  title,
  description,
  lang = 'es',
  jsonLd = [],
  ogImage = '/assets/og-default.jpg',
  esPath: esPathProp,
  enPath: enPathProp,
  needsTurnstile = false,
} = Astro.props;

// Every page exists in both languages under the same path, so the language
// pair can be derived from the URL. Spanish lives at the root, English under
// /en. trailingSlash is 'never', so paths are normalised without one.
//
// build.format is 'file' (so Cloudflare Pages serves /page directly instead
// of 308-redirecting to /page/), which means Astro.url.pathname reflects the
// physical output filename during the static build — e.g. '/en.html' or
// '/servicios/asilo-afirmativo.html' — not the clean served route. Strip the
// .html/index.html suffix before deriving es/en paths from it.
const path = Astro.url.pathname
  .replace(/(^|\/)index\.html$/, '$1')
  .replace(/\.html$/, '')
  .replace(/\/+$/, '') || '/';
const derivedEsPath = path === '/en' ? '/' : path.startsWith('/en/') ? path.slice(3) : path;
const derivedEnPath = derivedEsPath === '/' ? '/en' : `/en${derivedEsPath}`;
const esPath = esPathProp ?? derivedEsPath;
const enPath = enPathProp ?? derivedEnPath;

const absolute = (p: string) => `${SITE.url}${p}`;

const canonical = absolute(lang === 'en' ? enPath : esPath);
// hreflang needs absolute URLs and a self-referencing entry on every page —
// without either, Google discards the whole cluster. x-default points at the
// Spanish equivalent of this page, not at the homepage.
const alternates = [
  { hreflang: 'es', href: absolute(esPath) },
  { hreflang: 'en', href: absolute(enPath) },
  { hreflang: 'x-default', href: absolute(esPath) },
];

const pageDescription = description ?? (lang === 'en' ? SITE.descriptionEn : SITE.description);
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : absolute(ogImage);

// Remote, document-preparation service — NOT a law firm and NOT LegalService/
// Attorney in schema.org terms, matching the copy rules in CLAUDE.md. No
// `address`: the business has no publishable office location.
const professionalService = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.name,
  url: SITE.url,
  description: `${SITE.description} ${SITE.descriptionEn}`,
  telephone: CONTACT.phone,
  email: CONTACT.email,
  areaServed: { '@type': 'Country', name: 'US' },
  availableLanguage: ['es', 'en'],
  sameAs: [SOCIAL.instagram.url, SOCIAL.tiktok.url],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: CONTACT.hours.opens,
    closes: CONTACT.hours.closes,
  },
};

const jsonLdBlocks = [professionalService, ...jsonLd];
// Guards against a "</script>" substring in any interpolated value (e.g. a
// service description) breaking out of the JSON-LD script tag.
const safeJson = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | LPC Services</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {description && <meta name="description" content={description} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <link rel="canonical" href={canonical} />
  {alternates.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
  ))}
  <meta name="robots" content="index, follow" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />
  <meta property="og:title" content={`${title} | ${SITE.name}`} />
  {pageDescription && <meta property="og:description" content={pageDescription} />}
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={absoluteOgImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | ${SITE.name}`} />
  {pageDescription && <meta name="twitter:description" content={pageDescription} />}
  <meta name="twitter:image" content={absoluteOgImage} />

  {jsonLdBlocks.map((block) => (
    <script type="application/ld+json" set:html={safeJson(block)} is:inline />
  ))}

  {/* No `defer` here: the widget reads document.currentScript to find its
  insertion point, which is unreliable on deferred scripts across browsers.
  Deferring it once made the bubble render inline in the sticky nav instead
  of as a fixed bottom-right bubble. */}
  <script is:inline src="https://widgets.leadconnectorhq.com/loader.js" data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js" data-widget-id="6a5ffdc6b29959fc566a7ef2"></script>
  {needsTurnstile && (
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
  )}
</head>
<body>
  <a class="skip" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
  <Header lang={lang} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
  <script is:inline>
    // Progressive enhancement for the contact forms. Without JS the form still
    // POSTs natively and the message is still delivered; this only replaces the
    // raw JSON response with an inline message on the same page.
    (function () {
      var isEnglish = document.documentElement.lang === 'en';
      var COPY = isEnglish
        ? {
            sending: 'Sending…',
            failed:
              'We could not send your message. Please try again or contact us directly on WhatsApp.',
          }
        : {
            sending: 'Enviando…',
            failed:
              'No pudimos enviar su mensaje. Intente de nuevo o escríbanos directamente por WhatsApp.',
          };

      document.querySelectorAll('form[action="/api/contacto"]').forEach(function (form) {
        var button = form.querySelector('button[type="submit"]');
        var originalLabel = button ? button.textContent : '';

        var status = document.createElement('p');
        status.className = 'form-status';
        status.setAttribute('role', 'status');
        status.setAttribute('aria-live', 'polite');
        status.hidden = true;
        if (button) {
          button.insertAdjacentElement('afterend', status);
        } else {
          form.appendChild(status);
        }

        function show(state, text) {
          status.dataset.state = state;
          status.textContent = text;
          status.hidden = false;
        }

        form.addEventListener('submit', function (event) {
          event.preventDefault();
          status.hidden = true;
          if (button) {
            button.disabled = true;
            button.textContent = COPY.sending;
          }

          fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          })
            .then(function (res) {
              return res.json().then(
                function (data) {
                  return { ok: res.ok, data: data };
                },
                function () {
                  return { ok: false, data: {} };
                }
              );
            })
            .then(function (result) {
              if (result.ok && result.data.ok) {
                show('ok', result.data.message || '');
                form.reset();
              } else {
                show('error', result.data.error || COPY.failed);
              }
            })
            .catch(function () {
              show('error', COPY.failed);
            })
            .then(function () {
              // Turnstile tokens are single-use. The token in the DOM was just
              // redeemed, so reset the widget or a retry dies with
              // timeout-or-duplicate.
              if (window.turnstile) {
                window.turnstile.reset(form.querySelector('.cf-turnstile'));
              }
              if (button) {
                button.disabled = false;
                button.textContent = originalLabel;
              }
            });
        });
      });
    })();
  </script>
</body>
</html>
