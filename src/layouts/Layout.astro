---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  lang?: 'es' | 'en';
}

const { title, description, lang = 'es' } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | LPC Services</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {description && <meta name="description" content={description} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <link rel="canonical" href={lang === 'en' ? `https://lpc-services.com/en${Astro.url.pathname.replace('/en', '')}` : `https://lpc-services.com${Astro.url.pathname}`} />
  {lang === 'es' && <link rel="alternate" hreflang="en" href={`https://lpc-services.com/en${Astro.url.pathname}`} />}
  {lang === 'en' && <link rel="alternate" hreflang="es" href={Astro.url.pathname.replace('/en', '') || '/'} />}
  <link rel="alternate" hreflang="x-default" href="https://lpc-services.com/" />
  <meta name="robots" content="index, follow" />
  <script src="https://widgets.leadconnectorhq.com/loader.js" data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js" data-widget-id="6a5ffdc6b29959fc566a7ef2"></script>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
</head>
<body>
  <a class="skip" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
  <Header lang={lang} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
  <script is:inline>
    // Progressive enhancement for the contact forms. Without JS the form still
    // POSTs natively and the message is still delivered; this only replaces the
    // raw JSON response with an inline message on the same page.
    (function () {
      var isEnglish = document.documentElement.lang === 'en';
      var COPY = isEnglish
        ? {
            sending: 'Sending…',
            failed:
              'We could not send your message. Please try again or contact us directly on WhatsApp.',
          }
        : {
            sending: 'Enviando…',
            failed:
              'No pudimos enviar su mensaje. Intente de nuevo o escríbanos directamente por WhatsApp.',
          };

      document.querySelectorAll('form[action="/api/contacto"]').forEach(function (form) {
        var button = form.querySelector('button[type="submit"]');
        var originalLabel = button ? button.textContent : '';

        var status = document.createElement('p');
        status.className = 'form-status';
        status.setAttribute('role', 'status');
        status.setAttribute('aria-live', 'polite');
        status.hidden = true;
        if (button) {
          button.insertAdjacentElement('afterend', status);
        } else {
          form.appendChild(status);
        }

        function show(state, text) {
          status.dataset.state = state;
          status.textContent = text;
          status.hidden = false;
        }

        form.addEventListener('submit', function (event) {
          event.preventDefault();
          status.hidden = true;
          if (button) {
            button.disabled = true;
            button.textContent = COPY.sending;
          }

          fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          })
            .then(function (res) {
              return res.json().then(
                function (data) {
                  return { ok: res.ok, data: data };
                },
                function () {
                  return { ok: false, data: {} };
                }
              );
            })
            .then(function (result) {
              if (result.ok && result.data.ok) {
                show('ok', result.data.message || '');
                form.reset();
              } else {
                show('error', result.data.error || COPY.failed);
              }
            })
            .catch(function () {
              show('error', COPY.failed);
            })
            .then(function () {
              // Turnstile tokens are single-use. The token in the DOM was just
              // redeemed, so reset the widget or a retry dies with
              // timeout-or-duplicate.
              if (window.turnstile) {
                window.turnstile.reset(form.querySelector('.cf-turnstile'));
              }
              if (button) {
                button.disabled = false;
                button.textContent = originalLabel;
              }
            });
        });
      });
    })();
  </script>
</body>
</html>
